{
  "name": "emo",
  "version": "0.1.5",
  "description": "An all in one application, includes Reader-a rss reader",
  "main": "./dist/main/index.js",
  "scripts": {
    "prepare": "husky install",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "build": "npm run type && npm run clean && electron-vite build",
    "lint": "npm run eslint && npm run type",
    "eslint": "eslint src/ electron.vite.config.mts --ext .ts,.tsx,.js,.jsx,.mts",
    "type": "tsc --noEmit",
    "package": "npm run build && electron-builder --dir --publish never",
    "make": "npm run build && electron-builder --publish never",
    "publish": "npm run build && electron-builder --publish always",
    "test:smoke": "npm run build && node scripts/smoke.cjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "keywords": [
    "electron",
    "emo",
    "rss",
    "reader",
    "rss reader"
  ],
  "author": {
    "name": "creep",
    "email": "creepcn@gmail.com",
    "url": "https://xwcoder.github.io/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xwcoder/emo.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "@fluentui/react-components": "^9.30.1",
    "@fluentui/react-icons": "^2.0.218",
    "@types/lodash.get": "^4.4.7",
    "@types/lodash.set": "^4.3.9",
    "@types/node": "^24.19.2",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@types/xml2js": "^0.4.12",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-sonarjs": "^0.21.0",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "mobx": "^6.10.2",
    "mobx-react-lite": "^4.0.4",
    "postcss": "^8.4.30",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intl-universal": "^2.6.21",
    "tailwindcss": "^3.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "lodash.get": "^4.4.2",
    "lodash.set": "^4.3.2",
    "sqlite3": "^5.1.7",
    "winston": "^3.11.0",
    "xml2js": "^0.6.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
