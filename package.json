{
  "name": "yikan",
  "productName": "一刊",
  "version": "1.1.0",
  "description": "A desktop RSS and Atom reader",
  "desktopName": "yikan.desktop",
  "main": "./dist/main/index.js",
  "scripts": {
    "prepare": "husky install",
    "postinstall": "install-electron",
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "build": "npm run type && npm run clean && electron-vite build",
    "lint": "npm run eslint && npm run type",
    "eslint": "eslint src/ tests/ electron.vite.config.mts --ext .ts,.tsx,.js,.jsx,.mts",
    "type": "tsc --noEmit",
    "package": "npm run build && electron-builder --dir --publish never",
    "make": "npm run build && electron-builder --publish never",
    "publish": "npm run build && electron-builder --publish always",
    "test:smoke": "npm run build && node scripts/smoke.cjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "keywords": [
    "electron",
    "yikan",
    "rss",
    "reader",
    "rss reader"
  ],
  "author": {
    "name": "creep",
    "email": "creepcn@gmail.com",
    "url": "https://xwcoder.github.io/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xwcoder/yikan.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "@mozilla/readability": "^0.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@types/lodash.get": "^4.4.7",
    "@types/lodash.set": "^4.3.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.18",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-sonarjs": "^0.21.0",
    "husky": "^8.0.3",
    "i18next": "^27.1.3",
    "lint-staged": "^14.0.1",
    "lucide-react": "^1.74.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  },
  "dependencies": {
    "@exodus/bytes": "^1.16.0",
    "electron-updater": "^6.8.11",
    "html-encoding-sniffer": "^7.0.0",
    "lodash.get": "^4.4.2",
    "lodash.set": "^4.3.2",
    "parse5": "^8.1.1",
    "saxes": "^6.0.0",
    "semver": "~7.7.3"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
